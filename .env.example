# ============================================================================
#  ChollosBot ES · variables de entorno
#  cp .env.example .env  y rellena los valores. NUNCA subas .env al repositorio.
# ============================================================================

# --- Infraestructura --------------------------------------------------------
POSTGRES_USER=chollos
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=chollos

# Clave de cifrado de credenciales de n8n. Genérala una vez y no la pierdas:
#   openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# URL pública accesible desde internet. La necesitan el webhook del bot de
# Telegram y el redirector /webhook/r/:id. En local usa un túnel (cloudflared,
# ngrok) o despliega detrás de un proxy inverso con TLS.
PUBLIC_BASE_URL=https://chollos.tudominio.es
N8N_HOST=chollos.tudominio.es
N8N_PROTOCOL=https
N8N_SECURE_COOKIE=true

# --- Telegram ---------------------------------------------------------------
# Token que devuelve @BotFather al crear el bot
TELEGRAM_BOT_TOKEN=
# Canal de administración (@usuario o -100xxxxxxxxxx). El bot debe ser admin.
TELEGRAM_CHAT_ADMIN=@tu_canal_admin
# Enlace público del canal, usado como destino de reserva del redirector
CANAL_PUBLICO_URL=https://t.me/tu_canal_chollos

# --- IA ---------------------------------------------------------------------
# La clave va en la credencial "Anthropic API (x-api-key)" de n8n, no aquí.
MODELO_IA=claude-sonnet-5

# --- Seguridad --------------------------------------------------------------
# Sal para el hash de huella anónima de clics (RGPD). openssl rand -hex 16
HASH_SALT=
# Token compartido que deben enviar las redes en el postback de conversiones
POSTBACK_TOKEN=
# User-Agent identificable con vía de contacto, como pide la buena práctica
SCRAPER_USER_AGENT=ChollosBot/1.0 (+https://tudominio.es/bot; contacto@tudominio.es)

# --- Afiliación: el "% de venta" -------------------------------------------
# Amazon Partners (España). El tag es tu identificador de seguimiento.
AMAZON_ASSOC_TAG=tutag-21
AMAZON_PAAPI_KEY=
AMAZON_PAAPI_SECRET=

# Awin: ID de publisher + clave del datafeed
AWIN_AFF_ID=
AWIN_FEED_KEY=

TRADEDOUBLER_AFF_ID=
ADMITAD_AFF_ID=
ALIEXPRESS_TRACKING_ID=
EPN_CAMPAIGN_ID=
IMPACT_AFF_ID=
# Identificador para programas directos sin red intermediaria
AFF_ID_DIRECTO=chollosbot

# --- Ajustes de negocio (opcionales; hay valores por defecto en las consultas)
# Score mínimo para publicar y tope de publicaciones por hora se configuran
# en la tabla `canales`; estos son los valores de reserva.
CHOLLOS_SCORE_MIN=60
CHOLLOS_MAX_HORA=12
N8N_LOG_LEVEL=info
